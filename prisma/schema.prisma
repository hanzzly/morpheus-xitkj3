// Prisma schema — Website Kelas Cyber Security
// Provider: PostgreSQL (kompatibel dengan Vercel Postgres / Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // hash bcrypt, jangan pernah simpan plain text
  createdAt DateTime @default(now())
}

model Anggota {
  id        String   @id @default(cuid())
  nama      String
  email     String?  @unique
  jabatan   String   // contoh: "Ketua Kelas", "Wakil Ketua", "Sekretaris", "Anggota"
  fotoUrl   String?  // URL foto dari Cloudinary
  bio       String?
  portofolio String?
  urutan    Int      @default(0) // untuk mengatur urutan tampil
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jadwalPiket JadwalPiket[]
}

model GaleriItem {
  id           String   @id @default(cuid())
  judul        String
  deskripsi    String?
  gambarUrl    String   // URL dari Cloudinary
  cloudinaryId String?  // public_id Cloudinary, untuk keperluan hapus gambar
  urutan       Int      @default(0) // untuk mengatur urutan tampil
  createdAt    DateTime @default(now())
}

enum HariPiket {
  SENIN
  SELASA
  RABU
  KAMIS
  JUMAT
  SABTU
}

model JadwalPiket {
  id        String    @id @default(cuid())
  hari      HariPiket
  anggotaId String
  anggota   Anggota   @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  catatan   String?
  createdAt DateTime  @default(now())

  @@index([hari])
}

model Prestasi {
  id           String   @id @default(cuid())
  judul        String
  deskripsi    String
  gambarUrl    String
  cloudinaryId String?
  urutan       Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Visitor {
  id        String   @id @default(cuid())
  ip        String
  userAgent String
  device    String   // "Mobile" | "Desktop" | "Tablet"
  browser   String
  os        String
  referrer  String?
  visitedAt DateTime @default(now())
  path      String   @default("/")
}

model ChatMessage {
  id        String   @id @default(cuid())
  content   String   @db.VarChar(280) // max 280 karakter
  anonName  String   // contoh: "Anonim#4291"
  ip        String   @default("unknown") // IP asli untuk moderasi admin
  ipHash    String   // SHA-256 hash dari IP, untuk rate limiting
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ipHash])
  @@index([ip])
}

model BlockedIp {
  id        String   @id @default(cuid())
  ip        String   @unique
  alasan    String?  // alasan pemblokiran (misal: "Spam", "Kata tidak pantas")
  createdAt DateTime @default(now())

  @@index([ip])
}
